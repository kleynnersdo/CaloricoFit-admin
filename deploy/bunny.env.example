# Bunny.net Storage — copiar a /opt/backups/.env en el VPS
# Crear Storage Zone en https://panel.bunny.net/storage

BUNNY_STORAGE_ZONE=kleynners-backups
BUNNY_API_KEY=CAMBIAR_API_KEY
BUNNY_REGION=ny

# rclone config (una sola vez en VPS):
# rclone config
#   n) New remote
#   name: bunny
#   type: s3
#   provider: Other
#   env_auth: false
#   access_key_id: STORAGE_ZONE_NAME
#   secret_access_key: PASSWORD_FROM_STORAGE_ZONE
#   endpoint: https://ny.storage.bunnycdn.com
#   acl: private

# Cron (como deploy):
# 0 3 * * * /opt/backups/backup-dbs.sh >> /opt/backups/backup.log 2>&1
